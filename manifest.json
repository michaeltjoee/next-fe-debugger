{
  "manifest_version": 3,
  "name": "next-fe debugger",
  "version": "0.1.0",
  "description": "Inspect window.__NEXT_DATA__ on Next.js (Pages Router) sites.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/gateway-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "next-fe debugger",
    "default_popup": "dist/popup/popup.html",
    "default_icon": {
      "16": "icons/idle16.png",
      "32": "icons/idle32.png"
    }
  },
  "devtools_page": "dist/devtools/devtools.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
