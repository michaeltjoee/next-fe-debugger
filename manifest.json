{
  "manifest_version": 3,
  "name": "next-fe debugger",
  "version": "0.1.0",
  "description": "Inspect window.__NEXT_DATA__ on Next.js (Pages Router) sites.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/gateway-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "next-fe debugger",
    "default_popup": "dist/popup/popup.html",
    "default_icon": {
      "16": "icons/idle16.png",
      "32": "icons/idle32.png"
    }
  },
  "commands": {
    "open-version": {
      "suggested_key": { "default": "Alt+Shift+D", "mac": "Alt+Shift+D" },
      "description": "Open on the Version tab"
    },
    "open-gateway": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "Alt+Shift+F" },
      "description": "Open on the API Fetch tab"
    },
    "open-page": {
      "suggested_key": { "default": "Alt+Shift+G", "mac": "Alt+Shift+G" },
      "description": "Open on the Page Data tab"
    },
    "open-datalayer": {
      "suggested_key": { "default": "Alt+Shift+H", "mac": "Alt+Shift+H" },
      "description": "Open on the dataLayer tab"
    }
  },
  "devtools_page": "dist/devtools/devtools.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
